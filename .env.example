# Copy to .env (gitignored) and fill in. `uni <command> --remote` syncs this
# working tree to the host and runs the command there over ssh.
# Absolute path on the host, plain characters only; created if missing and mirrored with --delete.
UNI_REMOTE_HOST=my-run-host
UNI_REMOTE_USER=me
UNI_REMOTE_DIR=/Users/me/code/universality
